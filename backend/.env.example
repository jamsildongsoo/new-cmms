# =============================================================================
# 백엔드 환경설정 — 주요 설정 및 책임
# =============================================================================
# 이 파일은 NestJS 서버와 별도 초기 설정 명령에서 사용한다.
# 루트 .env는 Docker 호스트 설정, frontend/.env는 프런트 공개 설정을 담당한다.
#
# [모드] 변수명은 NODE_ENV이다. 개발 development / 배포 production.
# [동기화] DB_SYNCHRONIZE는 직접 설정한다. development여도 자동으로 켜지지 않는다.
#          개발 true 또는 false / 운영 false. 개발 외 true이면 시작을 거부한다.
#          항목 생략 시 기본값은 NODE_ENV=production, DB_SYNCHRONIZE=false이다.
# [직접 수정] DB 접속·TLS·CORS·JWT·업로드 정책은 환경에 맞게 지정한다.
# [Docker] Compose가 PORT=3000, API_PREFIX=api, TRUST_PROXY_HOPS=1,
#          FILE_STORAGE_DRIVER=local, FILE_LOCAL_ROOT=/app/uploads를 덮어쓴다.
# [우선순위] 실행 환경변수 > 이 파일 > 코드 기본값. 공란은 기본값 적용을 뜻하지 않는다.
# [npm 실행] package.json은 NODE_ENV를 지정하지 않는다. 서버가 이 파일에서 실행 모드를 읽는다.
#            start:dev/start:debug는 watch·디버그, start:prod는 빌드된 코드 실행만 선택한다.
#            외부 실행 환경변수 NODE_ENV가 있으면 이 파일보다 우선한다.
# [반영] 직접 실행은 재시작, Docker는 docker compose up -d --force-recreate.
# [초기 설정] ./bootstrap.sh schema → ./bootstrap.sh admin. 서비스는 ./start.sh.
#             회사·관리자 정보는 bootstrap에서 입력하며 이 파일에 저장하지 않는다.
# [보안] 실제 .env는 커밋하지 않는다. $·# 등이 있는 비밀번호는 작은따옴표로 감싼다.
# [작성] cp backend/.env.example backend/.env 후 공란을 실제 환경값으로 채운다.
# 이 예시는 개발 설정이다. 운영 배포 시 NODE_ENV=production, DB_SYNCHRONIZE=false로 변경한다.

# =============================================================================
# 1. 실행 환경
# =============================================================================
# development / production. test는 자동 검사 전용이다.
NODE_ENV=development

# =============================================================================
# 2. 서버·접근 설정
# =============================================================================
# 직접 실행 포트(1~65535). Docker는 3000 고정.
PORT=3000

# 앞뒤 / 없는 API 경로. Docker는 api 고정.
API_PREFIX=api

# 허용 프런트 origin을 쉼표로 구분한다. 경로·끝 슬래시·*는 허용하지 않는다.
# 개발 예: http://localhost,http://localhost:5173
# 운영 예: https://cmms.example.com — 실제 접속 origin으로 직접 교체한다.
CORS_ORIGINS=

# 직접 실행은 0. Docker는 내부 Nginx 한 단계에 맞춰 1로 지정한다.
TRUST_PROXY_HOPS=0

# =============================================================================
# 3. 데이터베이스 연결·TLS
# =============================================================================
# 개발·운영 DB와 접속 계정을 분리한다. Docker에서 접근 가능한 주소를 지정한다.
# Docker에서 localhost는 컨테이너 자신이다. Supabase는 Direct 또는 Session pooler 사용.
DB_HOST=

# PostgreSQL 접속 포트(1~65535).
DB_PORT=5432

# 애플리케이션 전용 DB 계정.
DB_USER=

# DB 접속 비밀번호. 외부에 노출하거나 프런트 환경파일에 넣지 않는다.
DB_PASSWORD=

# 접속 대상 DB명. 공급자 설정값을 확인한다.
DB_NAME=

# true/false. DB 공급자의 TLS 요구사항에 맞게 직접 선택한다. NODE_ENV와 자동 연동하지 않는다.
DB_SSL=true

# DB_SSL=true일 때 인증서를 검증한다. 일반적인 운영 설정은 true.
# DB_SSL=false이면 이 설정은 연결에 적용하지 않는다.
# 공급자 CA가 필요하면 NODE_EXTRA_CA_CERTS를 Node 시작 전에 지정한다.
# Docker 예: /app/certs/db-ca.crt (루트 DB_CERTS_HOST_PATH에 해당 파일 준비).
# 직접 실행 예: 호스트 인증서 절대 경로. 이 파일에만 적으면 직접 실행 시 적용이 늦다.
DB_SSL_REJECT_UNAUTHORIZED=true

# =============================================================================
# 4. 데이터베이스 동기화·로그
# =============================================================================
# true: 서버 시작 시 Entity 기준으로 스키마 생성·변경. 개발 전용 DB에서만 사용한다.
# false: 자동 변경 안 함. 운영은 반드시 false. NODE_ENV=development만으로 켜지지 않는다.
# 운영 최초 빈 public 설치는 ./bootstrap.sh schema로 별도 실행한다.
DB_SYNCHRONIZE=true

# SQL 로그 true/false. 운영 권장값 false.
DB_LOGGING=false

# =============================================================================
# 5. 인증
# =============================================================================
# 개발·운영별 서로 다른 충분히 긴 무작위 비밀값을 직접 지정한다.
JWT_ACCESS_SECRET=

# 만료시간은 단위를 포함한다: 15m, 1h, 7d. 최소 1초, 단위 없는 숫자는 금지.
JWT_ACCESS_EXPIRES_IN=15m

# =============================================================================
# 6. 파일 저장·업로드 정책
# =============================================================================
# 현재 local만 지원한다. Docker도 local 고정.
FILE_STORAGE_DRIVER=local

# 직접 실행 저장 경로. 상대 경로는 실행 위치와 관계없이 backend 디렉터리 기준.
# Docker는 /app/uploads 고정이며, 호스트 경로는 루트 .env의 UPLOADS_HOST_PATH에서 지정한다.
FILE_LOCAL_ROOT=./uploads

# 개별 파일 최대 크기(byte). 10485760 = 10 MiB.
FILE_MAX_SIZE_BYTES=10485760

# 요청당 최대 파일 개수(1 이상).
FILE_MAX_FILES_PER_UPLOAD=10

# 요청당 파일 합계 최대 크기(byte). 개별 제한 이상이어야 한다. 52428800 = 50 MiB.
# 크기 정책 변경 시 Nginx의 client_max_body_size(현재 60 MiB)도 함께 검토한다.
FILE_MAX_UPLOAD_TOTAL_BYTES=52428800

# 쉼표로 구분한 허용 MIME 목록.
FILE_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf,text/plain,text/csv,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/x-hwp,application/haansofthwp,application/vnd.hancom.hwp,application/vnd.hancom.hwpx,application/zip

# =============================================================================
# 7. 로그인 이력
# =============================================================================
# 보관일(0 이상). 0은 자동 삭제 안 함. 서버 시작 시 및 하루마다 정리한다.
LOGIN_HISTORY_RETENTION_DAYS=90
