# cp backend/.env.example backend/.env 후 빈 설정을 채운다. 실제 값은 커밋하지 않는다.
# 기본값은 개발용이다. 운영 서버에서는 복사한 backend/.env 자체를 수정한다.
# 운영 전환 전에 ./stop.sh를 실행하고 아래 항목과 URL·DB·비밀값·경로를 수정한다.
# 운영 설정 예시(아래의 같은 이름 항목을 수정하며 중복해서 추가하지 않는다):
# COMPOSE_FILE=compose.yaml:compose.prod.yaml
# NODE_ENV=production
# DB_SYNCHRONIZE=false
# CMMS_BIND_ADDRESS=0.0.0.0
# CMMS_HTTP_PORT=80
# CMMS_HTTPS_PORT=443
# CORS_ORIGINS=https://실제-운영-도메인
# 운영 YAML 두 개를 함께 선택한다. NODE_ENV만 바꾸면 YAML은 변경되지 않는다.
COMPOSE_FILE=compose.dev.yaml

# 운영: 0.0.0.0 또는 서비스할 서버 IP로 변경한다.
CMMS_BIND_ADDRESS=127.0.0.1
# 운영: HTTP 80, HTTPS 443으로 변경한다. 서버 방화벽·DNS도 함께 설정한다.
CMMS_HTTP_PORT=8080
CMMS_HTTPS_PORT=8443
# 운영: 영구 저장할 호스트 경로를 지정하고 backend UID/GID 1000에 쓰기 권한을 부여한다.
# 기존 첨부가 있으면 파일도 옮긴 후 경로를 변경한다. DB와 첨부를 함께 백업한다.
UPLOADS_HOST_PATH=./backend/uploads
# 운영: 실제 도메인의 fullchain.pem·privkey.pem을 이 디렉터리에 배치한다.
# DNS에서 도메인을 서버 IP로 연결한다. 이 값은 인증서 발급을 수행하지 않는다.
TLS_CERT_DIR=./deploy/tls
# 외부 DB 공급자 CA가 필요한 경우 인증서를 보관할 호스트 디렉터리다.
DB_CERTS_HOST_PATH=./deploy/db-certs

# 운영: production으로 변경한다. 개별 backend 실행에서도 이 값을 사용한다.
NODE_ENV=development
# 운영: localhost 항목을 실제 HTTPS origin으로 교체한다(경로·끝 슬래시 제외).
# 예: https://cmms.example.com / 복수 origin은 쉼표로 구분한다.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# 프런트 API 주소는 frontend/.env에서 설정한다. DB·JWT 값은 그 파일에 넣지 않는다.

# 운영: 개발 DB와 분리된 운영 DB 접속값·애플리케이션 전용 계정으로 채운다.
# Docker에서도 접근 가능한 DB 주소를 사용한다. DB의 localhost는 컨테이너 자신이다.
# Supabase Connect 화면의 Direct 또는 Session pooler 값을 사용한다.
DB_HOST=
DB_PORT=5432
DB_USER=
# 비밀번호에 $·# 등이 있으면 작은따옴표로 감싸 Compose의 치환·주석 해석을 피한다.
DB_PASSWORD=
DB_NAME=postgres
# 운영 외부 DB는 true / true 유지. 공급자 CA가 필요하면 아래 주석도 참고한다.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# 공급자 CA가 필요하면 위 인증서 폴더에 파일을 넣고 다음 줄을 사용한다.
# 아래 경로는 Docker 내부 경로다. backend 직접 실행은 호스트 절대 경로를
# Node 시작 전 환경변수로 지정해야 한다(ConfigModule 로딩 시점에는 적용되지 않음).
# NODE_EXTRA_CA_CERTS=/app/certs/db-ca.crt
# 운영: 반드시 false로 변경한다. production에서 true이면 NestJS가 시작을 거부한다.
DB_SYNCHRONIZE=true
# 운영: false 유지.
DB_LOGGING=false

# 개별 실행의 첨부 경로(backend 기준). 통합 실행과 같은 호스트 디렉터리를 가리킨다.
FILE_STORAGE_DRIVER=local
FILE_LOCAL_ROOT=./uploads

# 운영: 개발과 다른 충분히 긴 무작위 비밀값을 설정한다. 브라우저에 전달하지 않는다.
JWT_ACCESS_SECRET=
# 운영 로그인 유지 정책에 맞게 변경 가능. 기본 access token 만료 시간은 15분이다.
JWT_ACCESS_EXPIRES_IN=15m

# 업로드 정책 변경 시 Nginx 요청 제한(현재 60 MiB)도 함께 검토한다.
FILE_MAX_SIZE_BYTES=10485760
FILE_MAX_FILES_PER_UPLOAD=10
FILE_MAX_UPLOAD_TOTAL_BYTES=52428800
FILE_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf,text/plain,text/csv,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/x-hwp,application/haansofthwp,application/vnd.hancom.hwp,application/vnd.hancom.hwpx,application/zip

# 운영 최초 관리자 생성 전에 실제 회사·관리자 정보와 별도 강한 비밀번호로 변경한다.
# bootstrap은 명시적으로 실행할 때만 적용되며 서버 시작 시 자동 실행되지 않는다.
BOOTSTRAP_COMPANY_ID=CR
BOOTSTRAP_COMPANY_NAME=Core Company
BOOTSTRAP_ADMIN_USER_ID=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=System Admin
# 운영: false 유지. 기존 관리자 비밀번호를 의도적으로 재설정할 때만 true로 변경한다.
BOOTSTRAP_ADMIN_FORCE_PASSWORD=false
