# cp frontend/.env.example frontend/.env 후 사용한다. VITE_ 값은 브라우저에 공개된다.
# 개발·운영 모두 /api 유지. 운영은 같은 도메인의 Nginx가 NestJS로 전달한다.
# 별도 API 도메인을 쓰는 경우에만 https://실제-API-도메인/api 로 변경한다.
VITE_API_BASE_URL=/api

# 개별 개발의 Vite 프록시 대상. backend PORT 변경 시 함께 수정한다.
# 통합 Docker 실행에서는 Compose가 http://backend:3000으로 덮어쓴다.
# 운영 정적 프런트에는 사용하지 않는다.
API_PROXY_TARGET=http://127.0.0.1:3000
