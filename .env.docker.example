# 저장소 루트의 .env로 복사한다. Compose 설정과 backend 런타임에서 함께 사용한다.
CMMS_BIND_ADDRESS=127.0.0.1
CMMS_HTTP_PORT=8080
CMMS_HTTPS_PORT=8443
UPLOADS_HOST_PATH=./data/uploads
TLS_CERT_DIR=./deploy/tls
DB_CERTS_HOST_PATH=./deploy/db-certs

NODE_ENV=production
CORS_ORIGINS=http://localhost:8080
# Supabase Connect 화면의 Direct 또는 Session pooler 값을 사용한다.
DB_HOST=replace-with-external-postgres-host
DB_PORT=5432
DB_USER=replace-with-database-user
DB_PASSWORD='replace-with-database-password'
DB_NAME=postgres
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# 공급자 CA가 필요하면 위 인증서 폴더에 파일을 넣고 다음 줄을 사용한다.
# NODE_EXTRA_CA_CERTS=/app/certs/db-ca.crt
DB_SYNCHRONIZE=false
DB_LOGGING=false

JWT_ACCESS_SECRET=replace-with-random-access-secret
JWT_ACCESS_EXPIRES_IN=15m

FILE_MAX_SIZE_BYTES=10485760
FILE_MAX_FILES_PER_UPLOAD=10
FILE_MAX_UPLOAD_TOTAL_BYTES=52428800
FILE_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf,text/plain,text/csv,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/x-hwp,application/haansofthwp,application/vnd.hancom.hwp,application/vnd.hancom.hwpx,application/zip

BOOTSTRAP_COMPANY_ID=CR
BOOTSTRAP_COMPANY_NAME=Core Company
BOOTSTRAP_ADMIN_USER_ID=admin
BOOTSTRAP_ADMIN_PASSWORD='replace-with-admin-password'
BOOTSTRAP_ADMIN_NAME=System Admin
BOOTSTRAP_ADMIN_FORCE_PASSWORD=false
