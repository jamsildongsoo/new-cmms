# 고객 서버에서는 /srv/new-cmms/.env에 실제 값을 입력한다.
# 고객당 호스트 1대. 동일 호스트 내 산하 회사는 DB의 companyId로 구분한다.
COMPOSE_PROJECT_NAME=new-cmms
CMMS_BACKEND_IMAGE=cmms-backend:local
CMMS_FRONTEND_IMAGE=cmms-frontend:local
CMMS_POSTGRES_IMAGE=postgres:18.7
CMMS_BIND_ADDRESS=127.0.0.1
CMMS_HTTP_PORT=80

# 개발은 development / true 또는 false. 운영은 production / false.
NODE_ENV=development
DB_SYNCHRONIZE=false
DB_LOGGING=false
CORS_ORIGINS=http://localhost

# 빈 PostgreSQL 데이터 디렉터리의 첫 기동에 postgres와 cmms가 생성된다.
# DB_PASSWORD: NestJS가 사용하는 cmms 계정 비밀번호.
# POSTGRES_PASSWORD: PostgreSQL 관리 계정 postgres의 비밀번호.
# 두 항목을 모두 명시한다. 같은 값을 사용하려면 각각 같은 값을 입력한다.
# PostgreSQL 재기동 후 값을 수정해도 기존 DB 계정 비밀번호는 바뀌지 않는다.
DB_NAME=cmms
DB_PASSWORD=
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
LOGIN_HISTORY_RETENTION_DAYS=90

# 필요할 때만 기본 업로드 제한을 조정한다.
FILE_MAX_SIZE_BYTES=10485760
FILE_MAX_FILES_PER_UPLOAD=10
FILE_MAX_UPLOAD_TOTAL_BYTES=52428800
