# Docker Compose 배포별 설정. 공통 서비스 구조는 compose.yaml에서 관리한다.
# 기본 파일명 compose.yaml을 자동 사용하므로 COMPOSE_FILE은 지정하지 않는다.
# 백엔드 모드·DB·JWT는 backend/.env, 프런트 공개 설정은 frontend/.env에서 관리한다.
# 개발: NODE_ENV=development, DB_SYNCHRONIZE=true 또는 false. 운영: production/false.
# 실행 ./start.sh / 종료 ./stop.sh / 초기 설정 ./bootstrap.sh schema|admin.
# 변경 후 컨테이너를 재생성한다. restart만으로 환경변수 변경은 반영되지 않는다.
# 실제 .env는 커밋하지 않는다.
# 최초 작성: cp .env.example .env 후 호스트 환경에 맞게 수정한다.

# =============================================================================
# 1. 프로젝트
# =============================================================================
# 고객별 배포 시 구분한다. compose.yaml의 name보다 우선한다.
COMPOSE_PROJECT_NAME=new-cmms

# =============================================================================
# 2. 외부 접속
# =============================================================================
# 로컬 접속 기본값. 외부 공개 시 서버 환경에 맞게 수정한다.
CMMS_BIND_ADDRESS=127.0.0.1

# 개발 기본 서비스: 호스트 80 → Nginx 80. 접속 주소 http://localhost
CMMS_HTTP_PORT=80

# 운영 HTTPS 전환 시 주석 해제하고 Compose의 443 매핑도 활성화한다.
# CMMS_HTTPS_PORT=443

# 개발은 인증서 없는 HTTP. 운영 전환 시 아래 HTTPS 설정으로 교체한다.
CMMS_NGINX_CONFIG=./deploy/nginx/default.conf
# CMMS_NGINX_CONFIG=./deploy/nginx/https.conf

# =============================================================================
# 3. 인증서
# =============================================================================
# 브라우저 ↔ Nginx HTTPS용. fullchain.pem과 privkey.pem을 배치한다.
# 개발 HTTP는 빈 폴더로 준비한다. 운영 HTTPS 전환 전 인증서·개인키를 배치한다.
# 서버 개인키는 클라이언트에 전달하지 않는다. HTTPS 설정은 두 파일이 없으면 시작할 수 없다.
TLS_CERT_DIR=./deploy/tls

# 백엔드 ↔ DB TLS 검증용 공급자 CA 인증서. HTTPS 인증서와 별개다.
# 컨테이너 /app/certs로 연결된다. 사용하지 않아도 빈 폴더를 준비한다.
# backend/.env의 DB_SSL·DB_SSL_REJECT_UNAUTHORIZED와 필요 시 NODE_EXTRA_CA_CERTS로 사용한다.
DB_CERTS_HOST_PATH=./deploy/db-certs

# =============================================================================
# 4. 업로드 저장
# =============================================================================
# 상대 경로는 프로젝트 루트 기준. 컨테이너 /app/uploads에 연결된다.
# 폴더는 실행 전에 준비하고 UID/GID 1000이 쓸 수 있도록 권한을 설정한다.
# 기존 첨부가 있으면 경로를 유지한다. 경로 변경 시 파일은 자동 이동하지 않는다.
# Docker 없는 직접 실행은 backend/.env의 FILE_LOCAL_ROOT를 사용한다.
UPLOADS_HOST_PATH=./backend/uploads

# =============================================================================
# 5. 배포 이미지
# =============================================================================
# 소스 실행은 Compose 기본 local 이미지를 빌드한다.
# 소스 없는 배포는 docker load 후 전달받은 이미지 버전을 지정한다.
# CMMS_BACKEND_IMAGE=cmms-backend:버전
# CMMS_FRONTEND_IMAGE=cmms-frontend:버전
